flush ruleset

table inet nat {
    chain prerouting {
        type nat hook prerouting priority -100;
        ip daddr 198.51.100.1 tcp dport 80 dnat to 192.168.100.10:80
        ip daddr 198.51.100.1 tcp dport 443 dnat to 192.168.100.10:443
        ip daddr 198.51.100.1 udp dport 51820 dnat to 192.168.50.3:51820
    }
    chain postrouting {
        type nat hook postrouting priority 100;
        ip saddr 192.168.50.4 masquerade
    }
}

table inet filter {
    counter c_ext_invalid {}
    counter c_ext_to_web {}
    counter c_ext_to_vpn {}
    counter c_ext_fwint_out {}
    counter c_ext_fwd_drop {}

    chain forward {
        type filter hook forward priority 0; policy drop;
        ct state established,related accept
        ct state invalid counter name c_ext_invalid drop
        # снаружи -> опубликованные сервисы: только пакеты, прошедшие DNAT с публичного адреса
        # (ct status dnat), иначе прямой запрос на внутренний IP в обход публичного адреса тоже прошёл бы
        ip daddr 192.168.100.10 tcp dport { 80, 443 } ct status dnat counter name c_ext_to_web accept
        ip daddr 192.168.50.3 udp dport 51820 ct status dnat counter name c_ext_to_vpn accept
        # изнутри наружу: только fw-int (после Squid), на 80/443
        ip saddr 192.168.50.4 tcp dport { 80, 443 } counter name c_ext_fwint_out accept
        counter name c_ext_fwd_drop drop
    }
}
