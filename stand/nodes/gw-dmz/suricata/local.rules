# HOME_NET = dmz (192.168.100.0/24, то, что защищает gw-dmz), EXTERNAL_NET = всё остальное.
# Свои правила: suricata-update недоступен, сети стенда изолированы от интернета (этап 01).

# 1. Входящий ICMP echo-request из внешней сети в dmz (например attacker -> web).
alert icmp $EXTERNAL_NET any -> $HOME_NET any (itype:8; msg:"ICMP echo-request snaruzhi v DMZ"; sid:1000001; rev:1;)

# 2. Исходящий ICMP echo-reply из dmz во внешнюю сеть (ответ на пункт 1).
alert icmp $HOME_NET any -> $EXTERNAL_NET any (itype:0; msg:"ICMP echo-reply iz DMZ naruzhu"; sid:1000002; rev:1;)

# 3. Успешное HTTPS-подключение клиента к web: сервер прислал TLS-ответ (ServerHello и далее) —
# значит handshake состоялся. Сертификат (CN=198.51.100.1) не берём: Apache по умолчанию отдаёт
# TLS 1.3, где Certificate зашифрован и пассивному IDS не виден (см. results/03-ids.md).
alert tls $HOME_NET 443 -> $EXTERNAL_NET any (flow:to_client; msg:"Uspeshnoe HTTPS-podkluchenie k web (otvet servera v TLS-handshake)"; sid:1000003; rev:2;)

# 4. XSS: <script> в URI HTTP-запроса (search.php?q=<script>...).
alert http $EXTERNAL_NET any -> $HOME_NET any (flow:to_server,established; http.uri; content:"<script"; nocase; msg:"Vozmozhnaya XSS-ataka: <script> v HTTP-zaprose"; sid:1000004; rev:1;)

# 5-6. SQL-инъекция: типичные признаки в URI.
alert http $EXTERNAL_NET any -> $HOME_NET any (flow:to_server,established; http.uri; content:"OR 1=1"; nocase; msg:"Vozmozhnaya SQL-inekciya: OR 1=1 v HTTP-zaprose"; sid:1000005; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (flow:to_server,established; http.uri; content:"UNION SELECT"; nocase; msg:"Vozmozhnaya SQL-inekciya: UNION SELECT v HTTP-zaprose"; sid:1000006; rev:1;)

# 7. Сканирование портов: много SYN на разные порты dmz от одного источника за короткое время.
alert tcp any any -> $HOME_NET any (flags:S; threshold:type threshold, track by_src, count 20, seconds 10; msg:"Vozmozhnoe skanirovanie portov (mnogo SYN za korotkoe vremya)"; sid:1000007; rev:1;)

# 8-9. Попытка входа по FTP (команды USER/PASS в управляющем соединении на 21 порт).
alert tcp any any -> $HOME_NET 21 (flow:to_server,established; content:"USER "; nocase; msg:"FTP: popytka vhoda, komanda USER"; sid:1000008; rev:1;)
alert tcp any any -> $HOME_NET 21 (flow:to_server,established; content:"PASS "; nocase; msg:"FTP: popytka vhoda, komanda PASS"; sid:1000009; rev:1;)
